# Copy this file to .env.development (local) or .env.production (deploy)
# and fill in your Palantir Foundry instance details.

# OAuth callback URL (must match Developer Console config)
VITE_FOUNDRY_REDIRECT_URL=http://localhost:8080/auth/callback

# Your Foundry instance URL
VITE_FOUNDRY_API_URL=https://your-instance.palantirfoundry.co.uk

# OAuth Client ID from Developer Console
VITE_FOUNDRY_CLIENT_ID=your-client-id-here

# Ontology RID from Developer Console → Ontology SDK tab
VITE_FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
